{
  "name": "@suncreation/mcp-notion-server",
  "version": "2.0.0",
  "description": "MCP server for interacting with Notion API - SDK-based with caching, auto-pagination, and table management",
  "license": "MIT",
  "author": "SunCreation (https://github.com/SunCreation)",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-notion-server": "build/index.js"
  },
  "files": [
    "build",
    "Readme.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.2",
    "@notionhq/client": "^5.20.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/yargs": "^17.0.33",
    "typescript": "^5.3.3",
    "vitest": "^3.0.9"
  }
}
